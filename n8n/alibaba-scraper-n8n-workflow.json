            {
              "id": "d0fea11a-1765-5ab4-988c-bb87a4a1a52f",
              "name": "id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "0dafa58a-b81b-5220-a77d-3cf1df7bf04e",
